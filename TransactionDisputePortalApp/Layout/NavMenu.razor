@inject AuthService Auth

<!-- Fallback Bootstrap Icons CDN link to guarantee icons render -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<div class="sidebar-container">
    <!-- Brand Header -->
    <div class="sidebar-brand">
        <a class="navbar-brand fw-bold text-white d-flex align-items-center justify-content-center gap-2.5 m-0" href="">
            <div class="brand-icon-box">
                <i class="bi bi-shield-check text-white fs-5"></i>
            </div>
            <div class="d-flex flex-column text-center">
                <span class="fs-6 fw-bold text-white lh-1">DisputePortal</span>
                <span class="brand-subtext fw-normal mt-1">Secure Banking</span>
            </div>
        </a>
    </div>

    <!-- Navigation Body -->
    <div class="nav-scrollable flex-grow-1">
        <nav class="sidebar-nav flex-column py-2">
            <div class="nav-category">
                @(isStaff ? "Staff Menu" : "Customer Menu")
            </div>

            @if (!isStaff)
            {
                <!-- Customer Links -->
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-speedometer2 icon-info"></i>
                        <span>Dashboard</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="transactions">
                        <i class="bi bi-receipt-cutoff icon-info"></i>
                        <span>Transactions</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="disputes">
                        <i class="bi bi-exclamation-triangle icon-info"></i>
                        <span>Track Disputes</span>
                    </NavLink>
                </div>
            }
            else
            {
                <!-- Staff / Admin Links -->
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/disputes" Match="NavLinkMatch.All">
                        <i class="bi bi-kanban icon-warning"></i>
                        <span>Manage Disputes</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/customers" Match="NavLinkMatch.All">
                        <i class="bi bi-kanban icon-warning"></i>
                        <span>Manage Customers</span>
                    </NavLink>
                </div>
            }
        </nav>
    </div>
</div>

@code {
    private bool isStaff = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isStaff = await Auth.IsStaffAsync();
            StateHasChanged();
        }
    }
}