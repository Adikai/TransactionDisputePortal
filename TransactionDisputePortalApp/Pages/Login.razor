@page "/login"
@using System.Net.Http.Json
@using TransactionDisputePortal.Shared.Models.DTO
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthService AuthService

<div class="login-wrapper">
    <div class="login-card">
        <!-- Header Branding -->
        <div class="text-center mb-4">
            <div class="brand-avatar">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                </svg>
            </div>
            <h4 class="fw-bold text-dark mb-1">Welcome Back</h4>
            <p class="text-muted small mb-0">Sign in to your Dispute Portal account</p>
        </div>

        <!-- Form -->
        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <div class="form-floating mb-3">
                <InputText @bind-Value="loginModel.Email" class="form-control" id="floatingEmail" placeholder="name@example.com" />
                <label for="floatingEmail">Email Address</label>
            </div>

            <div class="form-floating mb-4">
                <InputText @bind-Value="loginModel.PasswordHash" type="password" class="form-control" id="floatingPassword" placeholder="Password" />
                <label for="floatingPassword">Password</label>
            </div>

            <button type="submit" class="btn btn-primary btn-login w-100 text-white" disabled="@isLoading">
                @if (isLoading)
                {
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Authenticating...</span>
                    </div>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-shake mt-4 mb-0 py-2.5 px-3 small rounded-3 d-flex align-items-center gap-2" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="flex-shrink-0" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                    </svg>
                    <div>@errorMessage</div>
                </div>
            }
        </EditForm>
    </div>
</div>
