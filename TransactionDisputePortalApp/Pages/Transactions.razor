@page "/transactions"
@using System.Globalization
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Transactions - Transaction Dispute Portal</PageTitle>

<style>
    .account-card {
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        user-select: none;
        border: 2px solid transparent;
    }

        .account-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
        }

        .account-card:active {
            transform: translateY(-1px) scale(0.98);
        }

        .account-card.selected {
            border-color: #0d6efd !important;
            background-color: rgba(13, 110, 253, 0.05);
        }

        .account-card .check-indicator {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: bold;
        }
</style>

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Account Transactions</h3>
            <p class="text-muted small mb-0">Search historical transactions and initiate disputes for unauthorized or incorrect charges.</p>
        </div>
    </div>

    <!-- Account Selection Cards -->
    <div class="mb-4">
        <label class="form-label fw-semibold text-muted small mb-2">Select Account</label>
        @if (customerAccounts == null)
        {
            <div class="d-flex align-items-center gap-2 py-3 text-muted small">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Loading accounts...</span>
            </div>
        }
        else if (!customerAccounts.Any())
        {
            <div class="alert alert-warning mb-0">No accounts found for this profile.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var acc in customerAccounts)
                {
                    var isSelected = filterModel.AccountNumber == acc.AccountNumber;
                    <div class="col-12 col-md-4">
                        <div class="card account-card rounded-3 p-3 h-100 bg-white @(isSelected ? "selected" : "")"
                             @onclick="() => SelectAccount(acc.AccountNumber)">

                            <!-- Card Header: Account Type Badge & Passive Selection Status -->
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-secondary text-white fw-medium px-2 py-1">
                                    @acc.AccountType
                                </span>
                                <span class="badge @(isSelected ? "bg-primary text-white" : "border border-primary text-primary bg-white") px-3 py-1">
                                    @(isSelected ? "Selected" : "Select")
                                </span>
                            </div>

                            <!-- Account Number -->
                            <div class="mb-3">
                                <strong class="fs-6 text-dark">@acc.AccountNumber</strong>
                            </div>

                            <!-- Balance Details -->
                            <div class="mb-2">
                                <span class="text-muted extra-small d-block">Available Balance</span>
                                <span class="fs-5 fw-bold text-success">
                                    @acc.Balance.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))
                                </span>
                            </div>

                            <!-- Active Disputes Footer (if applicable) -->
                            @if (acc.ActiveDisputeCount > 0)
                            {
                                <hr class="my-2 text-muted opacity-25" />
                                <div class="d-flex justify-content-between align-items-center extra-small fw-semibold text-danger">
                                    <span>⚠️ Active Disputes: @acc.ActiveDisputeCount</span>
                                    <span>@acc.TotalDisputedAmount.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm p-4 mb-4">
        <form @onsubmit="FetchTransactionsAsync" @onsubmit:preventDefault>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-sm-6 col-md-5">
                    <label class="form-label fw-semibold text-muted small mb-1">Start Date</label>
                    <input type="date" @bind="filterModel.StartDate" class="form-control" />
                </div>
                <div class="col-12 col-sm-6 col-md-5">
                    <label class="form-label fw-semibold text-muted small mb-1">End Date</label>
                    <input type="date" @bind="filterModel.EndDate" class="form-control" />
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold d-flex align-items-center justify-content-center gap-2" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Loading...</span>
                        }
                        else
                        {
                            <span>Search</span>
                        }
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <strong>Success:</strong> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- Transactions Data Table -->
    <div class="card border-0 shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Transaction Records</h5>
            @if (transactions != null)
            {
                <span class="badge bg-light text-dark border">
                    Total: <strong>@transactions.Count</strong> records
                </span>
            }
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading transactions...</span>
                </div>
                <p class="text-muted mt-2 mb-0 small">Fetching transactions for selected period...</p>
            </div>
        }
        else if (transactions == null)
        {
            <div class="text-center py-5 text-muted">
                <p class="mb-0">Select an account card above and click <strong>Search</strong> to load transaction history.</p>
            </div>
        }
        else if (!transactions.Any())
        {
            <div class="text-center py-5 text-muted">
                <p class="mb-0">No transactions found for the specified account and date range.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-uppercase text-muted">
                            <th>Date</th>
                            <th>Reference</th>
                            <th>Merchant</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in transactions)
                        {
                            <tr>
                                <td class="text-nowrap text-muted small">
                                    @txn.TransactionDate.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td class="fw-semibold">@txn.ReferenceNumber</td>
                                <td>@txn.MerchantName</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                        @txn.TransactionType
                                    </span>
                                </td>
                                <td class="text-end fw-bold">
                                    @txn.Amount.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))
                                </td>
                                <td class="text-center">
                                    <span class="badge @GetTransactionStatusBadge(txn.StatusName) px-2 py-1">
                                        @txn.StatusName
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-danger btn-sm fw-semibold"
                                            @onclick="() => OpenDisputeModal(txn)"
                                            disabled="@(txn.HasActiveDispute)">
                                        @(txn.HasActiveDispute ? "Disputed" : "Lodge Dispute")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Dispute Modal Backdrop -->
@if (showDisputeModal && selectedTransaction != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">Lodge Transaction Dispute</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDisputeModal"></button>
                </div>
                <form @onsubmit="SubmitDisputeAsync" @onsubmit:preventDefault>
                    <div class="modal-body p-4">
                        <div class="bg-light p-3 rounded mb-3 border">
                            <div class="row g-2 small">
                                <div class="col-6"><strong>Reference:</strong> @selectedTransaction.ReferenceNumber</div>
                                <div class="col-6"><strong>Merchant:</strong> @selectedTransaction.MerchantName</div>
                                <div class="col-6"><strong>Date:</strong> @selectedTransaction.TransactionDate.ToString("yyyy-MM-dd")</div>
                                <div class="col-6"><strong>Original Amount:</strong> @selectedTransaction.Amount.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Reason Category</label>
                            <select @bind="disputeModel.ReasonCategory" class="form-select">
                                <option value="">-- Select Reason --</option>
                                <option value="Fraudulent Charge">Fraudulent Charge / Unauthorized</option>
                                <option value="Incorrect Amount">Incorrect Amount Billed</option>
                                <option value="Duplicate Charge">Duplicate Transaction</option>
                                <option value="Goods Not Received">Goods / Services Not Received</option>
                                <option value="Paid via Other Means">Paid by Other Means</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Disputed Amount (ZAR)</label>
                            <input type="number" step="0.01" @bind="disputeModel.DisputedAmount" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Customer Notes / Reason Details</label>
                            <textarea @bind="disputeModel.CustomerNotes" class="form-control" rows="3" placeholder="Provide detailed context regarding why you are disputing this transaction..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseDisputeModal">Cancel</button>
                        <button type="submit" class="btn btn-danger fw-semibold px-4" disabled="@isSubmittingDispute">
                            @if (isSubmittingDispute)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Submitting...</span>
                            }
                            else
                            {
                                <span>Submit Dispute</span>
                            }
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}