@page "/admin/customers"
@using TransactionDisputePortal.Shared.Models.DTO

<PageTitle>Customer Management - DisputePortal Admin</PageTitle>

<div class="container-fluid py-4 px-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Customer Management</h3>
            <p class="text-muted small mb-0">Create, update, view, and manage customer accounts</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 fw-semibold rounded-3 shadow-sm" @onclick="OpenCreateModal">
            <i class="bi bi-person-plus-fill"></i>
            <span>Add New Customer</span>
        </button>
    </div>

    <!-- Error Alert Banner -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm p-3 mb-4 rounded-3">
        <div class="row g-3">
            <div class="col-12 col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Search by name, email, or account number..." @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-12 col-md-4 text-md-end">
                <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                    Total Customers: <strong>@FilteredCustomers.Count()</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- Customers Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr class="text-uppercase extra-small text-muted fw-bold">
                        <th>Customer ID</th>
                        <th>Full Name</th>
                        <th>Email / Contact</th>
                        <th>Password Hash</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredCustomers.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-2 d-block mb-2 text-secondary"></i>
                                No customers found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var customer in FilteredCustomers)
                        {
                            <tr>
                                <td class="fw-semibold font-monospace text-primary">#@customer.CustomerId</td>
                                <td>
                                    <div class="fw-bold text-dark">@customer.FullName</div>
                                    <span class="extra-small text-muted">Acc: @customer.AccountNumber</span>
                                </td>
                                <td>
                                    <div class="small">@customer.Email</div>
                                    <span class="extra-small text-muted">@customer.PhoneNumber</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <code class="bg-light text-danger px-2 py-1 rounded small text-break font-monospace" style="max-width: 260px; font-size: 0.75rem;">
                                            @customer.PasswordHash
                                        </code>
                                    </div>
                                </td>
                                <td class="text-muted small">@customer.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <button class="btn btn-outline-secondary btn-sm" title="Edit Customer" @onclick="() => OpenEditModal(customer)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" title="Delete Customer" @onclick="() => ConfirmDelete(customer)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create / Edit Customer Modal -->
@if (showModal)
{
    <div class="modal fade show d-block tab-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">
                        @(isEditMode ? "Edit Customer" : "Create New Customer")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="currentModel" OnValidSubmit="SaveCustomerAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body py-3">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Full Name</label>
                            <InputText class="form-control" @bind-Value="currentModel.FullName" placeholder="e.g. John Doe" />
                            <ValidationMessage For="@(() => currentModel.FullName)" class="text-danger extra-small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Email Address</label>
                            <InputText class="form-control" type="email" @bind-Value="currentModel.Email" placeholder="john@example.com" />
                            <ValidationMessage For="@(() => currentModel.Email)" class="text-danger extra-small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Phone Number</label>
                            <InputText class="form-control" @bind-Value="currentModel.PhoneNumber" placeholder="+27 82 123 4567" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Account Number</label>
                            <InputText class="form-control" @bind-Value="currentModel.AccountNumber" placeholder="ACC-100234" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                @(isEditMode ? "New Password (Leave blank to keep existing)" : "Password")
                            </label>
                            <InputText class="form-control font-monospace" type="password" @bind-Value="plainPassword" placeholder="Enter password..." />
                            <span class="extra-small text-muted d-block mt-1">
                                🔒 Password will be securely hashed using SHA-256 before storing.
                            </span>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top">
                        <button type="button" class="btn btn-secondary px-3" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            @(isEditMode ? "Update Customer" : "Create Customer")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && customerToDelete != null)
{
    <div class="modal fade show d-block tab-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-body text-center p-4">
                    <i class="bi bi-exclamation-circle text-danger fs-1 mb-2 d-block"></i>
                    <h5 class="fw-bold text-dark">Delete Customer?</h5>
                    <p class="text-muted small mb-3">
                        Are you sure you want to delete <strong>@customerToDelete.FullName</strong>? This action cannot be undone.
                    </p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-light px-3 fw-semibold" @onclick="() => showDeleteModal = false">Cancel</button>
                        <button class="btn btn-danger px-3 fw-semibold" @onclick="DeleteCustomerAsync">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}