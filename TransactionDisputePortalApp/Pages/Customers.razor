@page "/admin/customers"
@using TransactionDisputePortal.Shared.Models.DTO

<PageTitle>Customer Management - DisputePortal Admin</PageTitle>

<div class="container-fluid py-4 px-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Customer Management</h3>
            <p class="text-muted small mb-0">Create, update, view, and manage customer accounts</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 fw-semibold rounded-3 shadow-sm" @onclick="OpenCreateModal">
            <i class="bi bi-person-plus-fill"></i>
            <span>Add New Customer</span>
        </button>
    </div>

    <!-- Error Alert Banner -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm p-3 mb-4 rounded-3">
        <div class="row g-3">
            <div class="col-12 col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Search by name, email, or account number..." @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-12 col-md-4 text-md-end">
                <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                    Total Customers: <strong>@FilteredCustomers.Count()</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- Customers Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr class="text-uppercase extra-small text-muted fw-bold">
                        <th>Customer ID</th>
                        <th>Full Name</th>
                        <th>Email / Contact</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredCustomers.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-2 d-block mb-2 text-secondary"></i>
                                No customers found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var customer in FilteredCustomers)
                        {
                            <tr>
                                <td class="fw-semibold font-monospace text-primary">#@customer.CustomerID</td>
                                <td>
                                    <div class="fw-bold text-dark">@customer.FirstName @customer.LastName</div>
                                </td>
                                <td>
                                    <div class="small">@customer.Email</div>
                                    <span class="extra-small text-muted">@customer.PhoneNumber</span>
                                </td>
                                <td class="text-muted small">@customer.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <button class="btn btn-outline-primary btn-sm" title="Manage Accounts" @onclick="() => OpenAccountsModal(customer)">
                                            <i class="bi bi-wallet2"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" title="Edit Customer" @onclick="() => OpenEditModal(customer)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" title="Delete Customer" @onclick="() => ConfirmDelete(customer)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create / Edit Customer Modal -->
@if (showModal)
{
    <div class="modal fade show d-block tab-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">
                        @(isEditMode ? "Edit Customer" : "Create New Customer")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="currentModel" OnValidSubmit="SaveCustomerAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body py-3">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">First Name</label>
                            <InputText class="form-control" @bind-Value="currentModel.FirstName" placeholder="e.g. John" />
                            <ValidationMessage For="@(() => currentModel.FirstName)" class="text-danger extra-small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Last Name</label>
                            <InputText class="form-control" @bind-Value="currentModel.LastName" placeholder="e.g. Doe" />
                            <ValidationMessage For="@(() => currentModel.LastName)" class="text-danger extra-small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Email Address</label>
                            <InputText class="form-control" type="email" @bind-Value="currentModel.Email" placeholder="john@example.com" />
                            <ValidationMessage For="@(() => currentModel.Email)" class="text-danger extra-small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Phone Number</label>
                            <InputText class="form-control" @bind-Value="currentModel.PhoneNumber" placeholder="+27 82 123 4567" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Account Number</label>
                            <InputText class="form-control" @bind-Value="currentModel.AccountNumber" placeholder="ACC-100234" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                @(isEditMode ? "New Password (Leave blank to keep existing)" : "Password")
                            </label>
                            <InputText class="form-control font-monospace" type="password" @bind-Value="plainPassword" placeholder="Enter password..." />
                            <span class="extra-small text-muted d-block mt-1">
                                🔒 Password will be securely hashed using SHA-256 before storing.
                            </span>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top">
                        <button type="button" class="btn btn-secondary px-3" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            @(isEditMode ? "Update Customer" : "Create Customer")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && customerToDelete != null)
{
    <div class="modal fade show d-block tab-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-body text-center p-4">
                    <i class="bi bi-exclamation-circle text-danger fs-1 mb-2 d-block"></i>
                    <h5 class="fw-bold text-dark">Delete Customer?</h5>
                    <p class="text-muted small mb-3">
                        Are you sure you want to delete <strong>@customerToDelete.FirstName @customerToDelete.LastName</strong>? This action cannot be undone.
                    </p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-light px-3 fw-semibold" @onclick="() => showDeleteModal = false">Cancel</button>
                        <button class="btn btn-danger px-3 fw-semibold" @onclick="DeleteCustomerAsync">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Bank Accounts Sub-Management Modal -->
@if (showAccountsModal && selectedCustomerForAccounts != null)
{
    <div class="modal fade show d-block tab-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom bg-light">
                    <div>
                        <h5 class="modal-title fw-bold">Manage Bank Accounts</h5>
                        <span class="text-muted small">Customer: <strong>@selectedCustomerForAccounts.FirstName @selectedCustomerForAccounts.LastName</strong> (#@selectedCustomerForAccounts.CustomerID)</span>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseAccountsModal"></button>
                </div>
                <div class="modal-body py-3">

                    <!-- Create New Account Bar -->
                    <div class="card border p-3 mb-3 bg-light rounded-3">
                        <h6 class="fw-bold mb-2 text-dark small">Add New Bank Account</h6>
                        <EditForm Model="newAccountModel" OnValidSubmit="CreateAccountAsync">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-4">
                                    <InputText class="form-control form-control-sm" placeholder="Account Number (e.g. ACC-12345)" @bind-Value="newAccountModel.AccountNumber" />
                                </div>
                                <div class="col-md-3">
                                    <InputSelect class="form-select form-select-sm" @bind-Value="newAccountModel.AccountType">
                                        <option value="Checking">Checking</option>
                                        <option value="Savings">Savings</option>
                                        <option value="Credit Card">Credit Card</option>
                                    </InputSelect>
                                </div>
                                <div class="col-md-3">
                                    <InputNumber class="form-control form-control-sm" placeholder="Initial Balance" @bind-Value="newAccountModel.InitialBalance" />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-success btn-sm w-100 fw-semibold">
                                        <i class="bi bi-plus-circle me-1"></i> Add
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>

                    <!-- Customer Accounts List -->
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 border">
                            <thead class="table-light">
                                <tr class="extra-small text-muted text-uppercase fw-bold">
                                    <th>Account Number</th>
                                    <th>Type</th>
                                    <th>Balance</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!customerAccounts.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">
                                            No bank accounts linked to this customer yet.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var acc in customerAccounts)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold text-dark">@acc.AccountNumber</td>
                                            <td>
                                                <span class="badge bg-secondary opacity-75">@acc.AccountType</span>
                                            </td>
                                            <td class="fw-semibold text-success">
                                                R @acc.Balance.ToString("N2")
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-outline-danger btn-sm py-0 px-2" @onclick="() => DeleteAccountAsync(acc.AccountID)">
                                                    <i class="bi bi-trash extra-small"></i> Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseAccountsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}