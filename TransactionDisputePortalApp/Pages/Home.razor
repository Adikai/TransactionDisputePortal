@page "/"
@using System.Globalization

<PageTitle>Dashboard - Transaction Dispute Portal</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center py-5 style-loader">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading dashboard...</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger d-flex align-items-center justify-content-between my-4" role="alert">
        <div>
            <strong>Error loading dashboard:</strong> @errorMessage
        </div>
        <button class="btn btn-outline-danger btn-sm" @onclick="LoadDashboardDataAsync">Retry</button>
    </div>
}
else if (dashboardData != null)
{
    <div class="dashboard-container">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">Customer Dashboard</h3>
                <p class="text-muted small mb-0">Overview of your accounts and dispute activity</p>
            </div>
            <button class="btn btn-outline-danger btn-sm px-3 fw-semibold" @onclick="HandleLogoutAsync">
                Log Out
            </button>
        </div>

        <!-- Metric Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card border-0 shadow-sm p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Overall Balance</span>
                            <h3 class="fw-bold text-dark mb-0 mt-1">@dashboardData.Metrics.OverallBalance.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))</h3>
                        </div>
                        <div class="metric-icon bg-primary-subtle text-primary rounded-circle">
                            💳
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card border-0 shadow-sm p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Total Accounts</span>
                            <h3 class="fw-bold text-dark mb-0 mt-1">@dashboardData.Metrics.TotalAccountsCount</h3>
                        </div>
                        <div class="metric-icon bg-info-subtle text-info rounded-circle">
                            🏦
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card border-0 shadow-sm p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Active Disputes</span>
                            <h3 class="fw-bold text-warning mb-0 mt-1">@dashboardData.Metrics.OverallActiveDisputeCount</h3>
                        </div>
                        <div class="metric-icon bg-warning-subtle text-warning rounded-circle">
                            ⚠️
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card border-0 shadow-sm p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Disputed Amount</span>
                            <h3 class="fw-bold text-danger mb-0 mt-1">@dashboardData.Metrics.OverallDisputedAmount.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))</h3>
                        </div>
                        <div class="metric-icon bg-danger-subtle text-danger rounded-circle">
                            💸
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Accounts Grid -->
        <h5 class="fw-bold mb-3">Your Accounts</h5>
        <div class="row g-3 mb-4">
            @foreach (var account in dashboardData.Accounts)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card account-card border-0 shadow-sm p-3 h-100 @(selectedAccountId == account.AccountId ? "active-account" : "")">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-secondary mb-1">@account.AccountType</span>
                                <h6 class="fw-bold text-dark mb-0">@account.AccountNumber</h6>
                            </div>
                            <button class="btn btn-sm @(selectedAccountId == account.AccountId ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SelectAccount(account.AccountId)">
                                @(selectedAccountId == account.AccountId ? "Selected" : "Select")
                            </button>
                        </div>
                        <div class="mt-2">
                            <span class="text-muted small">Available Balance</span>
                            <h5 class="fw-bold text-success mb-0">@account.Balance.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))</h5>
                        </div>
                        @if (account.ActiveDisputeCount > 0)
                        {
                            <div class="mt-3 pt-2 border-top small text-danger d-flex justify-content-between">
                                <span>⚠️ Active Disputes: <strong>@account.ActiveDisputeCount</strong></span>
                                <strong>@account.TotalDisputedAmount.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))</strong>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Main Content Split -->
        <div class="row g-4">
            <!-- Recent Disputes Table -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Recent Disputes</h5>
                        <button class="btn btn-link btn-sm text-decoration-none fw-semibold p-0"
                                @onclick='() => Navigation.NavigateTo("/disputes")'>
                            View All Disputes
                        </button>
                    </div>

                    @if (dashboardData.RecentDisputes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="small text-uppercase text-muted">
                                        <th>Ref Number</th>
                                        <th>Reason</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dispute in dashboardData.RecentDisputes)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@dispute.ReferenceNumber</td>
                                            <td>@dispute.ReasonCategory</td>
                                            <td class="fw-bold">@dispute.DisputedAmount.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))</td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(dispute.StatusName) px-2 py-1">
                                                    @dispute.StatusName
                                                </span>
                                            </td>
                                            <td class="text-muted small">@dispute.CreatedAt.ToString("yyyy-MM-dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <p class="mb-0">No recent disputes found across your accounts.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions Panel -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-3">Quick Actions</h5>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary py-2 fw-semibold"
                                    @onclick='() => Navigation.NavigateTo("/transactions")'>
                                Search Transactions
                            </button>
                            <button class="btn btn-outline-secondary py-2 fw-semibold"
                                    @onclick='() => Navigation.NavigateTo("/disputes")'>
                                Track Active Disputes
                            </button>
                        </div>
                    </div>

                    @if (SelectedAccount != null)
                    {
                        <div class="account-card-badge p-3 rounded-3 bg-light mt-4">
                            <span class="text-muted small d-block mb-1">Active Selected Account</span>
                            <strong class="d-block text-dark fs-5">@SelectedAccount.AccountNumber</strong>
                            <span class="text-muted small">Type: @SelectedAccount.AccountType</span>
                            <span class="text-success small fw-semibold d-block mt-1">
                                Balance: @SelectedAccount.Balance.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}